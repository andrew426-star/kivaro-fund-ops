# Used server-side only, in src/app/api/narrative/route.ts — generates
# the AI narrative synthesis over the already-computed reconciliation
# results and NAV summary. Never exposed to the client (no NEXT_PUBLIC_
# prefix). The reconciliation matching and NAV arithmetic themselves are
# plain TypeScript and need no API key at all.
GEMINI_API_KEY=
# Optional override — defaults to gemini-flash-latest (a live-updating
# alias) if unset.
GEMINI_MODEL=
